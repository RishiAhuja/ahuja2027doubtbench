#!/bin/bash
#PBS -N caisc_exp18_factorial
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

PYTHON="${PYTHON:-$HOME/vlm-hpc/env/bin/python}"
HF_HOME="${HF_HOME:-$HOME/vlm-hpc/hf-cache}"
MODEL="${MODEL:-Qwen/Qwen2.5-7B-Instruct}"
EXPERIMENT_ID="${EXPERIMENT_ID:-EXP-18}"
RUN_ROOT="${RUN_ROOT:-$PBS_O_WORKDIR/outputs/$EXPERIMENT_ID}"
RUN_DIR="${RUN_DIR:-$RUN_ROOT/${MODEL_TAG:-model}_${PBS_JOBID}}"
DATA_FILE="${DATA_FILE:-experiments/data/exp16_self_doubt_focus_pilot.jsonl}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-384}"
BATCH_SIZE="${BATCH_SIZE:-8}"
THINKING_MODE="${THINKING_MODE:-auto}"
MAX_PARSE_FAILURE_RATE="${MAX_PARSE_FAILURE_RATE:-0.02}"
MAX_TRUNCATION_RATE="${MAX_TRUNCATION_RATE:-0.02}"

mkdir -p "$RUN_DIR" "$HF_HOME"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"
export HF_HUB_DOWNLOAD_TIMEOUT="${HF_HUB_DOWNLOAD_TIMEOUT:-120}"

if [[ -n "${MIG_UUID:-}" ]]; then
  export CUDA_VISIBLE_DEVICES="$MIG_UUID"
fi
if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "ERROR: CUDA_VISIBLE_DEVICES is empty; submit with one MIG_UUID."
  exit 2
fi
if [[ "$CUDA_VISIBLE_DEVICES" == *","* ]]; then
  echo "ERROR: refusing multiple visible GPUs: $CUDA_VISIBLE_DEVICES"
  exit 2
fi

echo "===== CAISC EXP-18 COMMON-PREFIX FACTORIAL ====="
date
echo "PBS_JOBID=${PBS_JOBID:-}"
echo "HOSTNAME=$(hostname)"
echo "MODEL=$MODEL"
echo "EXPERIMENT_ID=$EXPERIMENT_ID"
echo "DATA_FILE=$DATA_FILE"
echo "MAX_NEW_TOKENS=$MAX_NEW_TOKENS"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "THINKING_MODE=$THINKING_MODE"
echo "MAX_PARSE_FAILURE_RATE=$MAX_PARSE_FAILURE_RATE"
echo "MAX_TRUNCATION_RATE=$MAX_TRUNCATION_RATE"
echo "PYTHON=$PYTHON"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "RUN_DIR=$RUN_DIR"
nvidia-smi -L || true

"$PYTHON" -m experiments.exp18.run_open_factorial \
  --experiment-id "$EXPERIMENT_ID" \
  --model "$MODEL" \
  --data-file "$DATA_FILE" \
  --cache-dir "$HF_HOME" \
  --max-new-tokens "$MAX_NEW_TOKENS" \
  --batch-size "$BATCH_SIZE" \
  --thinking-mode "$THINKING_MODE" \
  --max-parse-failure-rate "$MAX_PARSE_FAILURE_RATE" \
  --max-truncation-rate "$MAX_TRUNCATION_RATE" \
  --out "$RUN_DIR" \
  --resume
