#!/bin/bash
#PBS -N caisc_exp02_smoke
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

RUN_DIR="${RUN_DIR:-$PBS_O_WORKDIR/outputs/EXP-02/gpu_smoke_${PBS_JOBID}}"
PYTHON="${PYTHON:-python3}"
HF_HOME="${HF_HOME:-/Data3/it_FA0571/hf_cache}"
MODEL="${MODEL:-meta-llama/Llama-3.1-8B-Instruct}"
COUNTS="${COUNTS:-gsm8k:5,mmlu:5}"
CONDITIONS="${CONDITIONS:-baseline,melancholic,negative_capability}"

mkdir -p "$RUN_DIR"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"

if [[ -n "${MIG_UUID:-}" ]]; then
  export CUDA_VISIBLE_DEVICES="$MIG_UUID"
fi

if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "ERROR: CUDA_VISIBLE_DEVICES is empty."
  echo "Set MIG_UUID from nvidia-smi -L when submitting."
  nvidia-smi -L || true
  exit 2
fi

if [[ "$CUDA_VISIBLE_DEVICES" == *","* ]]; then
  echo "ERROR: refusing multiple visible GPUs: CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
  exit 2
fi

echo "===== CAISC EXP-02 GPU SMOKE ====="
date
echo "PBS_JOBID=${PBS_JOBID:-}"
echo "HOSTNAME=$(hostname)"
echo "MODEL=$MODEL"
echo "COUNTS=$COUNTS"
echo "CONDITIONS=$CONDITIONS"
echo "PYTHON=$PYTHON"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "RUN_DIR=$RUN_DIR"
nvidia-smi -L || true

# Placeholder until the local/open backend is implemented.
# The API smoke runner is intentionally not used here because API jobs are CPU/network-bound.
"$PYTHON" - <<'PY'
print("GPU smoke PBS template validated. Implement experiments.exp02.run_open before real GPU inference.")
PY
