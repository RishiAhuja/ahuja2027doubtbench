#!/bin/bash
#PBS -N icfd31k_cpu_suite
#PBS -q cpuq
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /Data3/it_FA0571/icfd31k_extension/logs/cpu_suite.log

set -euo pipefail
cd /Data3/it_FA0571/caisc
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate "${ICFD31K_CONDA_ENV:-cultural_env}"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=16
export MKL_NUM_THREADS=16
export ICFD31K_DATA_ROOT=/Data3/it_FA0571/icfd31k_extension/data/final_upload_format
export ICFD31K_OUTPUT_ROOT=/Data3/it_FA0571/icfd31k_extension/outputs
export ICFD31K_PYTHON="$(command -v python)"

bash experiments/icfd31k_extension/run_cpu_suite.sh

