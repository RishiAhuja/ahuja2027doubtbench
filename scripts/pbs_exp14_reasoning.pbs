#!/bin/bash
#PBS -N caisc_exp14_reasoning
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"

JOB_ENV_FILE="${JOB_ENV_FILE:-}"
if [[ -n "$JOB_ENV_FILE" && -f "$JOB_ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$JOB_ENV_FILE"
fi

RUN_DIR="${RUN_DIR:-$PBS_O_WORKDIR/outputs/EXP-14/gpu_${PBS_JOBID}}"
PYTHON="${PYTHON:-/Data3/it_FA0571/.conda/envs/cultural_env/bin/python}"
HF_HOME="${HF_HOME:-/Data3/it_FA0571/hf_cache}"
MODEL="${MODEL:-Qwen/Qwen3-14B}"
COUNTS_FILE="${COUNTS_FILE:-configs/counts_exp14_pilot.json}"
CONDITIONS="${CONDITIONS:-baseline,neutral_librarian,melancholic,anxious,self_doubt_only,capability_denial_only,explicit_sabotage}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-2048}"
BATCH_SIZE="${BATCH_SIZE:-2}"
PROMPT_PLACEMENT="${PROMPT_PLACEMENT:-system}"
THINKING_MODE="${THINKING_MODE:-auto}"

mkdir -p "$RUN_DIR"

export PYTHONNOUSERSITE=1
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export HF_HOME
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"

HF_ENV="${HF_ENV:-$HOME/.config/caisc/hf.env}"
if [[ -f "$HF_ENV" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$HF_ENV"
  set +a
fi

if [[ -n "${MIG_UUID:-}" ]]; then
  export CUDA_VISIBLE_DEVICES="$MIG_UUID"
fi

if [[ -z "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  echo "ERROR: CUDA_VISIBLE_DEVICES is empty."
  echo "Set MIG_UUID from nvidia-smi -L when submitting."
  nvidia-smi -L || true
  exit 2
fi

if [[ "$CUDA_VISIBLE_DEVICES" == *","* ]]; then
  echo "ERROR: refusing multiple visible GPUs: CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
  exit 2
fi

echo "===== CAISC EXP-14 REASONING ====="
date
echo "PBS_JOBID=${PBS_JOBID:-}"
echo "HOSTNAME=$(hostname)"
echo "MODEL=$MODEL"
echo "COUNTS_FILE=$COUNTS_FILE"
echo "CONDITIONS=$CONDITIONS"
echo "MAX_NEW_TOKENS=$MAX_NEW_TOKENS"
echo "BATCH_SIZE=$BATCH_SIZE"
echo "PROMPT_PLACEMENT=$PROMPT_PLACEMENT"
echo "THINKING_MODE=$THINKING_MODE"
echo "PYTHON=$PYTHON"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "RUN_DIR=$RUN_DIR"
nvidia-smi -L || true

RUN_ARGS=(
  --model "$MODEL"
  --conditions "$CONDITIONS"
  --counts-file "$COUNTS_FILE"
  --cache-dir "$HF_HOME"
  --max-new-tokens "$MAX_NEW_TOKENS"
  --batch-size "$BATCH_SIZE"
  --prompt-placement "$PROMPT_PLACEMENT"
  --thinking-mode "$THINKING_MODE"
  --out "$RUN_DIR"
)

"$PYTHON" -m experiments.exp14.run_open_reasoning "${RUN_ARGS[@]}"
